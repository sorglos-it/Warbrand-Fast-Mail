# Controls what ends up in the uploaded zip. Read by BigWigs' packager and
# by CurseForge's own packaging service, so it works for either route.

package-as: Warbrand-Fast-Mail

# No embedded libraries, so there is nothing to strip for a "nolib" build.
enable-nolib-creation: no

# The TOC is hand-maintained; do not generate per-flavour ones.
enable-toc-creation: no

license-output: LICENSE

ignore:
  - tools          # build_lang.py, not loaded in game
  - screenshots    # project page material
  - curseforge.md  # project page text, not addon content
  - logo.png       # 2 MB, has no business in the addon folder
  - logo_klein.png # project page artwork, same reason
  - .github
